# project data (uploads, transcripts, renders)
projects/*
!projects/.gitkeep

# python
.venv/
__pycache__/
*.pyc

# frontend
frontend/node_modules/
frontend/node_modules/.tmp/

# editor / os
.DS_Store
*.log

# service recordings and their transcripts
services/

# launcher: downloaded FFmpeg and personal settings
tools/
config.env

# end screen: your own settings and the generated video (see templates/outro.example.json)
templates/outro.json
templates/outro.mp4
templates/outro.ass

# logos, brands, music and the word list: your own content (see the .example.json files)
templates/logos/*
!templates/logos/.gitkeep
templates/brands/
templates/music/*
!templates/music/.gitkeep
templates/woordenlijst.json
templates/outro-achtergrond.*

# evaluation set: real services are the church's own recordings and transcripts
evaluation/*/
!evaluation/voorbeeld-dienst/
evaluation/*.json
