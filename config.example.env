# Church Reel Maker settings. Copy is made automatically as config.env on first start.
# Lines starting with # are comments.

# Needed for "Full service" clip suggestions with Claude. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Or run the suggestions fully local with Ollama (https://ollama.com): set LLM_PROVIDER=ollama
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1

# Speech recognition model: tiny, base, small (default), medium, large-v3. Bigger is slower and better.
# WHISPER_MODEL=small

# Optional. A Hugging Face access token (https://huggingface.co/settings/tokens) makes the
# first download of the speech model quicker. The model is public, so it works fine without
# one; this only silences their advice to get one and lifts the download rate limit.
# HF_TOKEN=

# Which model is used when a service is ticked as "nauwkeuriger uitschrijven".
# WHISPER_MODEL_ACCURATE=medium

# The estimate before "Beste momenten zoeken" is priced from Anthropic's dollar list and
# shown in euros. Set this when the rate has moved far enough to bother you.
# EUR_PER_USD=0.86

# How long a service recording is kept before the app clears it away by itself. The
# transcript, the found moments and your finished videos always stay. Set to 0 to never
# clean up automatically; the Opruimen panel then still lets you do it by hand.
# KEEP_WEEKS=4
